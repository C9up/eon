{
  "name": "@c9up/eon",
  "version": "0.2.6",
  "description": "Eon \u2014 time-series data layer for the Ream framework (TDengine-backed)",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "LICENSE",
    "README.md",
    "dist",
    "index.*.node",
    "scripts",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./configure": {
      "types": "./src/configure.ts",
      "import": "./src/configure.ts"
    },
    "./health": {
      "types": "./src/health.ts",
      "import": "./src/health.ts"
    },
    "./provider": {
      "types": "./src/EonProvider.ts",
      "import": "./src/EonProvider.ts"
    },
    "./schema": {
      "types": "./src/schema/index.ts",
      "import": "./src/schema/index.ts"
    },
    "./tmq": {
      "types": "./src/tmq/index.ts",
      "import": "./src/tmq/index.ts"
    },
    "./services/connection": {
      "types": "./src/services/connection.ts",
      "import": "./src/services/connection.ts"
    },
    "./testing": {
      "types": "./src/testing/index.ts",
      "import": "./src/testing/index.ts"
    },
    "./testing/vitest": {
      "types": "./src/testing/vitest.ts",
      "import": "./src/testing/vitest.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:rust": "cargo build --release -p eon-query-napi",
    "build:napi": "pnpm build:rust && pnpm build:napi-types && node scripts/copy-napi.mjs",
    "build:napi-types": "node scripts/build-napi-types.mjs",
    "test": "vitest run",
    "test:rust": "cargo test -p eon-query",
    "lint": "biome check src/",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@tdengine/websocket": "3.5.0",
    "reflect-metadata": "^0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.10",
    "@types/node": "^22",
    "tsx": "^4.19.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./configure": {
        "types": "./dist/configure.d.ts",
        "import": "./dist/configure.js"
      },
      "./health": {
        "types": "./dist/health.d.ts",
        "import": "./dist/health.js"
      },
      "./provider": {
        "types": "./dist/EonProvider.d.ts",
        "import": "./dist/EonProvider.js"
      },
      "./schema": {
        "types": "./dist/schema/index.d.ts",
        "import": "./dist/schema/index.js"
      },
      "./tmq": {
        "types": "./dist/tmq/index.d.ts",
        "import": "./dist/tmq/index.js"
      },
      "./services/connection": {
        "types": "./dist/services/connection.d.ts",
        "import": "./dist/services/connection.js"
      },
      "./testing": {
        "types": "./dist/testing/index.d.ts",
        "import": "./dist/testing/index.js"
      },
      "./testing/vitest": {
        "types": "./dist/testing/vitest.d.ts",
        "import": "./dist/testing/vitest.js"
      }
    },
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/C9up/eon.git"
  },
  "peerDependencies": {
    "vitest": ">=3"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  }
}
